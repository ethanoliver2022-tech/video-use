# Transcription (editing existing footage)
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# AI video generation — set the one you use. Veo is the default provider.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# LUMA_API_KEY=
# RUNWAY_API_KEY=
# OPENAI_API_KEY=

# Optional overrides — hosted video APIs move fast; point at a new endpoint or
# model without editing helpers/generate.py.
# VEO_MODEL=veo-3.1-generate-preview
# VEO_API_BASE=https://generativelanguage.googleapis.com/v1beta
# LUMA_MODEL=ray-2
# RUNWAY_MODEL=gen4_turbo
# SORA_MODEL=sora-2

# ---------------------------------------------------------------------------
# Publishing — set only the destination you actually use.
# ---------------------------------------------------------------------------

# YouTube. Create an OAuth client of type "TVs and Limited Input devices" at
# console.cloud.google.com with the YouTube Data API v3 enabled, then run:
#   python helpers/publish.py --auth youtube
# which writes YOUTUBE_REFRESH_TOKEN below for unattended uploads.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API (developers.tiktok.com)
# TIKTOK_ACCESS_TOKEN=

# Instagram Reels via the Graph API. Business/Creator account linked to a
# Facebook Page. Publishing pulls the file from a public URL (--video-url).
# IG_USER_ID=
# IG_ACCESS_TOKEN=
