# Required: create a bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=
# Optional: pin the owner chat instead of pairing with /start <code>
TELEGRAM_CHAT_ID=
# Needed before going live: a paid Solana RPC (Helius, Triton, QuickNode...)
SOLANA_RPC_URL=
# Optional but recommended: PumpPortal API key (pumpportal.fun). Enables the live
# trade stream (instant prices, dev-dump + KOL + sell-pressure exits) and copy
# trading. PumpPortal bills its linked wallet per message, so keep it funded.
PUMPPORTAL_API_KEY=
# Optional: free Jupiter API key from portal.jup.ag (the keyless API is being retired)
JUPITER_API_KEY=
# Optional: set the wallet here instead of creating/importing it from Telegram
# (locks the wallet against changes from chat)
SOLANA_PRIVATE_KEY=
# Advanced, optional: a self-hosted Telegram Bot API server (default https://api.telegram.org)
TELEGRAM_API_BASE=
# Optional security locks. They live only here, so even someone who got into your
# Telegram account couldn't change them:
# - withdrawals only to these addresses (comma-separated), e.g. your Phantom wallet
WITHDRAW_ALLOWLIST=
# - set to false so the private key can never be shown in Telegram
ALLOW_KEY_EXPORT=true
# Advanced: every swap transaction built by PumpPortal / Jupiter is checked before it's
# signed. If a future pump.fun update makes the bot refuse its trades (it tells you the
# program id in Telegram), add that id here (comma-separated) after checking it.
EXTRA_ALLOWED_PROGRAMS=
